NEXT_PUBLIC_API_BASE_URL=https://egbeda-api-dev.jumpingcrab.com
NEXT_PUBLIC_SITE_URL=https://egbedalg.gov.ng

# Optional. Enables the contact form photo attachment, which needs an API token
